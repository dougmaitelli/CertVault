{
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts e2e playwright.config.ts --max-warnings 0",
    "lint:fix": "eslint src scripts e2e playwright.config.ts --fix",
    "format": "prettier --write src scripts eslint.config.mjs package.json tsconfig.json vite.config.ts index.html e2e playwright.config.ts tsconfig.e2e.json",
    "format:check": "prettier --check src scripts eslint.config.mjs package.json tsconfig.json vite.config.ts index.html e2e playwright.config.ts tsconfig.e2e.json",
    "screenshots": "node scripts/take-screenshots.mjs",
    "screenshots:docker": "sh scripts/screenshots-docker.sh",
    "test": "pnpm run typecheck && pnpm run typecheck:e2e && sh scripts/test-client-installer.sh",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test && pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:docker": "sh scripts/e2e-docker.sh",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}

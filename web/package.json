{
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write src scripts eslint.config.mjs package.json tsconfig.json vite.config.ts index.html",
    "format:check": "prettier --check src scripts eslint.config.mjs package.json tsconfig.json vite.config.ts index.html",
    "screenshots": "node scripts/take-screenshots.mjs",
    "screenshots:docker": "sh scripts/screenshots-docker.sh",
    "test": "npm run typecheck && sh scripts/test-client-installer.sh",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  }
}
